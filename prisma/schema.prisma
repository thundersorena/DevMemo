

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}


model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  timezone      String?
  githubLogin   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  days       Day[]
  notes      Note[]
  commits    Commit[]
  githubHook GitHubHook?
  apiTokens  ApiToken[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Day {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime @db.Date
  isWorkDay Boolean  @default(false)
  summary   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  notes   Note[]
  commits Commit[]

  @@unique([userId, date])
  @@index([userId, date])
  @@map("day")
}

enum NoteSource {
  MANUAL
  MCP
  TELEGRAM
}

model Note {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayId     String
  day       Day        @relation(fields: [dayId], references: [id], onDelete: Cascade)
  content   String
  source    NoteSource @default(MANUAL)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([dayId, createdAt])
  @@index([userId])
  @@map("note")
}

model Commit {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  dayId          String
  day            Day      @relation(fields: [dayId], references: [id], onDelete: Cascade)
  sha            String
  repositoryId   String
  repositoryName String
  message        String
  branch         String?
  url            String
  authorName     String?
  authorEmail    String?
  committedAt    DateTime
  createdAt      DateTime @default(now())

  /// SHA is unique per user: retried webhook deliveries are idempotent,
  /// and two users who share a repository each keep their own copy.
  @@unique([userId, sha])
  @@index([dayId])
  @@index([userId, repositoryName])
  @@map("commit")
}

/// Per-user GitHub webhook endpoint: /api/webhooks/github/{id}.
model GitHubHook {
  id                  String    @id @default(cuid())
  userId              String    @unique
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// AES-256-GCM encrypted with a key derived from BETTER_AUTH_SECRET.
  secretEncrypted     String
  onlyOwnCommits      Boolean   @default(true)
  lastDeliveryAt      DateTime?
  lastDeliveryStatus  String?
  lastDeliveryMessage String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@map("github_hook")
}

/// Personal access token for the REST API and MCP. Only the SHA-256 hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("api_token")
}
