# ─── Database ──────────────────────────────────────────────────────────────
# Local Postgres from docker-compose.yml:
DATABASE_URL="postgresql://devmemo:devmemo@localhost:5432/devmemo?schema=public"

# ─── Auth (Better Auth) ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL of the app. Use https:// in production (enables secure cookies).
BETTER_AUTH_URL="http://localhost:3000"

# ─── GitHub OAuth App ──────────────────────────────────────────────────────
# Create at https://github.com/settings/developers → New OAuth App
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ─── App ───────────────────────────────────────────────────────────────────
# Default timezone for users who haven't picked one in Settings (IANA name).
APP_TIMEZONE="UTC"
